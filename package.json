{
  "name": "assisteai-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test src",
    "check": "bun run typecheck && bun run lint",
    "test:contract": "bun test test/contract",
    "legacy:up": "docker compose -f test/legacy-env/compose.yaml up -d --build --wait",
    "legacy:down": "docker compose -f test/legacy-env/compose.yaml down -v"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.3.14",
    "eslint": "9.39.5",
    "eslint-plugin-perfectionist": "4.15.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "hono": "4.13.13",
    "zod": "4.6.7"
  }
}
