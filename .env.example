# Copy to .env (Bun loads it automatically). Production sets these in the service environment.
NODE_ENV=development
PORT=3000
# Production: 127.0.0.1 behind nginx (the default)
HOST=
# Per minute: sign-ins per client IP and ratings per user (default 30). High locally: the API tests sign in a lot.
RATE_LIMIT_PER_MINUTE=1000
# debug | info | warn | error (default: debug in development, info in production)
LOG_LEVEL=
# Frontend origins allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:3003,https://assisteai.com.br,https://beta2.assisteai.com.br

# Postgres (compose.yaml)
DATABASE_URL=postgres://assisteai:assisteai@127.0.0.1:55432/assisteai

# Google sign-in: the OAuth client the frontend uses
GOOGLE_CLIENT_ID=736877274011-im98og8tkedl1gdtvjrj6u217dpqf9rq.apps.googleusercontent.com
# Default: Google's keys. Locally and in tests, the mock's:
GOOGLE_JWKS_URL=http://127.0.0.1:8080/www.googleapis.com/oauth2/v3/certs
# Production: .assisteai.com.br (unset: host-only cookie)
SESSION_COOKIE_DOMAIN=

# TMDb: API read access token (v4 auth). Locally and in tests the base URL is the mock's.
TMDB_API_TOKEN=
TMDB_API_URL=http://127.0.0.1:8080/api.themoviedb.org
# Links in Telegram notifications
FRONTEND_URL=https://assisteai.com.br
# New ratings are posted to this chat (both unset: notifications off). Locally and in tests: the mock.
TELEGRAM_BOT_TOKEN=local-bot-token
TELEGRAM_CHAT_ID=-1000000000000
TELEGRAM_API_URL=http://127.0.0.1:8080/api.telegram.org
