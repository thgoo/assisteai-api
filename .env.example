# Copy to .env (Bun loads it automatically). Production sets these in the service environment.
NODE_ENV=development
PORT=3000
# debug | info | warn | error (default: debug in development, info in production)
LOG_LEVEL=
# Frontend origins allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:3003,https://assisteai.com.br,https://beta2.assisteai.com.br

# Postgres (compose.yaml)
DATABASE_URL=postgres://assisteai:assisteai@127.0.0.1:55432/assisteai

# Shared with the legacy app (tokens work on both). At least 32 bytes.
JWT_SECRET=local-legacy-env-jwt-secret-must-be-at-least-256-bits-long-0123456789
# Default: https://www.googleapis.com. The contract suite points it at the mock:
GOOGLE_API_URL=http://127.0.0.1:8080/www.googleapis.com
