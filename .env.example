# Copy to .env (Bun loads it automatically). Production sets these in the service environment.
NODE_ENV=development
PORT=3000
# debug | info | warn | error (default: debug in development, info in production)
LOG_LEVEL=
# Frontend origins allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:3003,https://assisteai.com.br,https://beta2.assisteai.com.br
